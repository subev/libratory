DATABASE_URL=postgres://libratory:libratory@localhost:5433/libratory
DATA_DIR=./data
PORT=3034
# Vite's dev-server port, and the only reason to set it: running a second checkout alongside this
# one. The dev server proxies the API at PORT above, so offsetting both is all a second copy needs.
# WEB_PORT=3033
# Localhost only by default. Set 0.0.0.0 to reach the library from another device on your network —
# there is no login, so anyone on that network can read and delete everything in it.
# HOST=127.0.0.1
# Hostnames a browser may reach this server by, comma-separated (`host:port` off the default port).
# Only names need listing — an IP-literal Host is already accepted, since DNS rebinding cannot
# produce one. Set it when a reverse proxy or an mDNS/tailnet name fronts the server.
# TRUSTED_HOSTS=library.example.com
# Where the Python workers, the migrations, the built UI and the .env itself are found. Unset, all
# are worked out by walking up from the server's source, which is right when running from the repo
# and meaningless once the server is a single binary — a packaged build passes them in.
# LIBRATORY_HOME=/opt/libratory
# SCRIPTS_DIR=/opt/libratory/scripts
# MIGRATIONS_DIR=/opt/libratory/drizzle
# WEB_DIR=/opt/libratory/web
# Which file the ⚙️ Settings panel writes API keys to. The desktop app points this at its own
# directory; set it to a checkout's .env to share one set of keys between the app and `pnpm dev`.
# LIBRATORY_ENV_FILE=/opt/libratory/.env
# Python env bin dir — scripts/setup.sh appends the real value (defaults to <repo>/.venv/bin)
# CONDA_ENV_PATH=
# AI cloud providers — set any; each configured provider's models show up in the in-app pickers.
# Local models need NO configuration: Ollama and LM Studio servers are auto-discovered,
# and every installed chat model appears in the pickers automatically (fully offline AI).
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# The model ⚙️ Settings → "Default AI model" writes. Unset means automatic: V4 Flash when a
# DeepSeek key is configured, else the first available model.
# DEFAULT_LLM_MODEL=ollama:qwen3.8:27b
# Custom OpenAI-compatible server (mlx_lm.server, llama.cpp, a remote box) — only needed
# when it is not Ollama/LM Studio on the default ports.
# LOCAL_LLM_URL=http://localhost:8080/v1
# LOCAL_LLM_MODEL=my-model
# LOCAL_LLM_LABEL=Local (my-model)
# LOCAL_LLM_CONTEXT_TOKENS=32768
# Set false if the custom local model can't do tool calling (disables it for library chat only)
# LOCAL_LLM_TOOLS=true
# Optional: Cartesia cloud TTS (`cartesia:` voices). Without it the Cartesia tab in the voice picker stays empty.
CARTESIA_API_KEY=
# Optional: ElevenLabs (`elevenlabs:` voices). The free tier issues a key and 10,000 characters
# a month — roughly ten minutes of audio, and no commercial use. Synthesis refuses before spending
# anything if a chapter would not fit in what is left.
ELEVENLABS_API_KEY=
# eleven_multilingual_v2 (1 credit/char, best) or eleven_flash_v2_5 (0.5, twice as much audio)
# ELEVENLABS_MODEL=eleven_multilingual_v2
# Optional, setup-time only: HuggingFace token for Pocket TTS voice cloning.
# The 26 built-in Pocket TTS voices need no token. Cloning weights are gated — accept the
# terms at https://huggingface.co/kyutai/pocket-tts, then re-run `pnpm run setup`.
# HF_TOKEN=
# Optional: copy finished synced-EPUB exports here (Storyteller watch folder)
# READALOUD_DROP_DIR=/absolute/path/to/storyteller/data/import
