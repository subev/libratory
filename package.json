{
  "name": "libratory",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Petar Sabev",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:server": "pnpm --filter @libratory/server dev",
    "dev:web": "pnpm --filter @libratory/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @libratory/server db:generate",
    "db:migrate": "pnpm --filter @libratory/server db:migrate",
    "e2e:smoke": "pnpm --filter @libratory/e2e smoke",
    "e2e:full": "pnpm --filter @libratory/e2e full",
    "e2e:ui": "pnpm --filter @libratory/e2e ui",
    "setup": "bash scripts/setup.sh",
    "jobs": "bash scripts/jobs.sh",
    "jobs:clear": "source .env 2>/dev/null; psql \"$DATABASE_URL\" -c 'DELETE FROM graphile_worker._private_jobs; SELECT count(*) AS remaining FROM graphile_worker._private_jobs;'",
    "app": "bash scripts/desktop-build.sh --fast --install",
    "app:dmg": "bash scripts/desktop-build.sh",
    "release": "node scripts/release.mjs",
    "ship": "node scripts/ship.mjs",
    "typecheck": "pnpm -r --filter \"./packages/*\" exec tsc --noEmit",
    "lint": "node scripts/check-tokens.mjs && node scripts/check-icons.mjs && node scripts/check-buttons.mjs && oxlint packages scripts e2e",
    "lint:fix": "oxlint packages scripts e2e --fix"
  },
  "devDependencies": {
    "oxlint": "^1.82.0",
    "oxlint-tailwindcss": "^1.11.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "pnpm": {
    "overrides": {
      "@fastify/busboy@<3.2.1": "^3.2.2",
      "@xmldom/xmldom@<0.9.12": "^0.9.12",
      "brace-expansion@<2": "^1.1.21",
      "brace-expansion@>=2 <3": "^2.1.7",
      "brace-expansion@>=5 <5.0.12": "^5.0.12",
      "dompurify": "^3.4.16",
      "esbuild@<0.28.1": "^0.28.2",
      "fast-uri@>=3 <3.1.8": "^3.1.8",
      "fast-uri@>=4 <4.1.5": "^4.2.1",
      "ip-address@<10.7.1": "^10.7.3",
      "js-yaml@>=4 <4.3.1": "^4.3.2",
      "picomatch@>=4 <4.0.7": "^4.0.7",
      "prismjs": "^1.30.0",
      "trim": "0.0.3",
      "undici@>=6 <6.28.1": "^6.29.0",
      "undici@>=7 <7.29.1": "^7.30.0",
      "uuid": "14.0.2",
      "valibot": "^1.4.2",
      "vite": "^8.2.2"
    },
    "patchedDependencies": {
      "plist@3.1.0": "patches/plist@3.1.0.patch"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-ch52-4w7c-c8xp"
      ]
    }
  },
  "dependencies": {
    "defuddle": "^0.19.3",
    "linkedom": "^0.18.13"
  }
}
