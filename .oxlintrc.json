{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "react",
    "import"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/release/**",
    "**/node_modules/**",
    "packages/desktop/resources/**"
  ],
  "rules": {
    "no-await-in-loop": "off",
    "no-shadow": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-array-sort": "off",
    "no-control-regex": "off",
    "react-in-jsx-scope": "off",
    "tailwindcss/no-unknown-classes": "error",
    "tailwindcss/no-conflicting-classes": "error",
    "tailwindcss/no-deprecated-classes": "error",
    "tailwindcss/no-duplicate-classes": "error",
    "tailwindcss/no-dark-without-light": "error",
    "tailwindcss/no-hardcoded-colors": "error",
    "tailwindcss/no-restricted-classes": [
      "error",
      {
        "patterns": [
          {
            "pattern": "\\(--pal-",
            "message": "Palette tokens are raw colour. Use a semantic token (--accent, --danger, --text-muted, ...) or add one to the semantic block in styles.css."
          },
          {
            "pattern": "^-?(p|px|py|pt|pr|pb|pl|m|mx|my|mt|mr|mb|ml|gap|gap-x|gap-y|space-x|space-y)-(5|9|10|11|13|14|18|24|28|32|36|40|44|48|52|56|60|64|72|80|96)$",
            "message": "Off the spacing ladder. Use 0.5 1 1.5 2 2.5 3 4 6 7 8 12 16 20 — see \"Spacing\" in AGENTS.md. 5 and 10 round down to 4 and 8."
          },
          {
            "pattern": "^-?(p|px|py|pt|pr|pb|pl|m|mx|my|mt|mr|mb|ml|gap|gap-x|gap-y|space-x|space-y)-\\[",
            "message": "Arbitrary spacing. Use a ladder step (0.5 1 1.5 2 2.5 3 4 6 7 8 12 16 20) — see \"Spacing\" in AGENTS.md."
          }
        ]
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@phosphor-icons/react",
            "message": "Import icons from components/icons instead, so the set stays swappable and reusable. Missing one? Add a line to packages/web/src/components/icons.tsx."
          }
        ]
      }
    ]
  },
  "jsPlugins": [
    "oxlint-tailwindcss"
  ],
  "settings": {
    "tailwindcss": {
      "entryPoint": "packages/web/src/styles.css"
    }
  },
  "overrides": [
    {
      "files": [
        "packages/web/src/components/icons.tsx"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
