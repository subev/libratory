{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "react",
    "import"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/release/**",
    "**/node_modules/**",
    "packages/desktop/resources/**"
  ],
  "rules": {
    "no-await-in-loop": "off",
    "no-shadow": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-array-sort": "off",
    "no-control-regex": "off",
    "react-in-jsx-scope": "off",
    "tailwindcss/no-unknown-classes": "error",
    "tailwindcss/no-conflicting-classes": "error",
    "tailwindcss/no-deprecated-classes": "error",
    "tailwindcss/no-duplicate-classes": "error",
    "tailwindcss/no-dark-without-light": "error",
    "tailwindcss/no-hardcoded-colors": "error",
    "tailwindcss/no-restricted-classes": [
      "error",
      {
        "patterns": [
          {
            "pattern": "\\(--pal-",
            "message": "Palette tokens are raw colour. Use a semantic token (--accent, --danger, --text-muted, ...) or add one to the semantic block in styles.css."
          }
        ]
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@phosphor-icons/react",
            "message": "Import icons from components/icons instead, so the set stays swappable and reusable. Missing one? Add a line to packages/web/src/components/icons.tsx."
          }
        ]
      }
    ]
  },
  "jsPlugins": [
    "oxlint-tailwindcss"
  ],
  "settings": {
    "tailwindcss": {
      "entryPoint": "packages/web/src/styles.css"
    }
  },
  "overrides": [
    {
      "files": [
        "packages/web/src/components/icons.tsx"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
