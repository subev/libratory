{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "allowImportingTsExtensions": true,
    "declaration": false,
    "declarationMap": false,
    "noImplicitAny": false
  },
  "include": [
    "src"
  ]
}
