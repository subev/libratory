{
  "name": "@libratory/desktop",
  "private": true,
  "version": "26.831.0",
  "description": "Turns PDFs and EPUBs into audiobooks you can read along with, on your own machine.",
  "author": "Petar Sabev",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "start": "electron ."
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.2"
  },
  "main": "src/main.cjs",
  "build": {
    "appId": "dev.libratory.app",
    "productName": "Libratory",
    "artifactName": "${productName}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns"
    },
    "extraResources": [
      {
        "from": "resources",
        "to": "."
      },
      {
        "from": "../../scripts",
        "to": "scripts"
      },
      {
        "from": "../server/drizzle",
        "to": "drizzle"
      },
      {
        "from": "../../pyproject.toml",
        "to": "pyproject.toml"
      },
      {
        "from": "../../uv.lock",
        "to": "uv.lock"
      },
      {
        "from": "../../docker-compose.yml",
        "to": "docker-compose.yml"
      }
    ],
    "dmg": {
      "icon": "build/icon.icns"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "subev",
        "repo": "libratory",
        "releaseType": "draft"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
