  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "test": "vitest run",
    "start": "node dist/main.js",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "backfill:raw": "tsx src/scripts/backfill-raw-text.ts",
    "backfill:index": "tsx src/scripts/backfill-search-index.ts",
    "backfill:textmap": "tsx src/scripts/backfill-text-map.ts",
    "cleanup:chunks": "tsx src/scripts/cleanup-chunk-wavs.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.41",
    "@ai-sdk/google": "^4.0.50",
    "@ai-sdk/openai": "^4.0.46",
    "@ai-sdk/openai-compatible": "^3.0.27",
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^8.0.0",
    "@trpc/server": "^11.1.0",
    "@vivliostyle/cli": "^11.1.0",
    "ai": "^7.0.58",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.2.0",
    "graphile-worker": "^0.16.6",
    "music-metadata": "^11.12.0",
    "postgres": "^3.4.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
